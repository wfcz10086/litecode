# 复制为 .env 后按本机修改 (svc.sh 与 docker compose 都会读取)
# 镜像仓库前缀与标签
REGISTRY=ccr.ccs.tencentyun.com/preview
TAG=v1
# 推送需要登录时填 (不填则沿用已有的 docker login)
# REGISTRY_USER=
# REGISTRY_PASS=

# 宿主机端口 (只监听本机网卡, 不做公网映射)
SENSEVOICE_PORT=18011
ACESTEP_PORT=18012
INDEXTTS2_PORT=18013
ANISORA_PORT=18014

# 显卡分配: *_GPU 写 nvidia-smi 卡号, *_DEV 写该卡的设备文件 /dev/nvidiaN
# 注意 N ≠ 卡号! 用下面命令查 (Device Minor 就是 N):
#   nvidia-smi --query-gpu=index,pci.bus_id --format=csv
#   grep -H "Device Minor" /proc/driver/nvidia/gpus/*/information
# 下面是 gpu-a 的取值: 卡5=nvidia11 卡6=nvidia4 卡7=nvidia5 卡8=nvidia0 卡9=nvidia1 卡10=nvidia2 卡11=nvidia3
SENSEVOICE_GPU=5
SENSEVOICE_DEV=/dev/nvidia11
INDEXTTS2_GPU=5
INDEXTTS2_DEV=/dev/nvidia11
ACESTEP_GPU=6
ACESTEP_DEV=/dev/nvidia4
# AniSora 固定 5 卡 (Ulysses 并行度须整除 40 个注意力头: 可选 1/2/4/5/8;
# 改卡数需同时改 ANISORA_NPROC 和 docker-compose.yml 里 anisora 的 device_ids / devices 条目)
ANISORA_NPROC=5
ANISORA_GPU_1=7
ANISORA_GPU_2=8
ANISORA_GPU_3=9
ANISORA_GPU_4=10
ANISORA_GPU_5=11
ANISORA_DEV_1=/dev/nvidia5
ANISORA_DEV_2=/dev/nvidia0
ANISORA_DEV_3=/dev/nvidia1
ANISORA_DEV_4=/dev/nvidia2
ANISORA_DEV_5=/dev/nvidia3
