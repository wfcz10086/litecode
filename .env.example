# ══════════════════════════════════════════════════════
#  LiteCode v11-r6  环境配置
#  cp .env.example .env  然后填入你的值
# ══════════════════════════════════════════════════════

# ── AI 后端 ───────────────────────────────────────────
BACKEND_URL=https://aigc.gether.net/v1
API_KEY=sk-your-api-key-here
MODEL_ID=MiniMax-M2.5

# ── 服务鉴权 Token（Web UI / API 共用）────────────────
SERVER_TOKEN=CHANGE_ME_TOKEN

# ── Web UI 访问密码（留空则不启用密码保护）────────────
WEB_PASSWORD=

# ── 宿主机端口（改这里映射不同端口，容器内不变）──────
# SERVER_PORT=18789     # OpenClaw API
# WEB_PORT=18790        # Web UI
# NOVNC_PORT=18800      # noVNC 桌面

# ── 绑定 IP（默认 0.0.0.0，改为 127.0.0.1 仅本机访问）
# HOST_IP=0.0.0.0

# ── 微信保活（22h 给用户发提醒，防 24h token 过期）────
WX_KEEPALIVE_HOURS=22
WX_KEEPALIVE_MSG=🤖 会话即将过期，回复任意消息即可续期~

# ── 时区 ─────────────────────────────────────────────
TZ=Asia/Shanghai

# ── VNC 桌面（1=始终启动，0=按需）────────────────────
VNC_ALWAYS=1
